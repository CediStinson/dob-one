---
import "@fontsource-variable/inter/index.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Seite dauerhaft aus Suchmaschinen halten (z. B. geparkter Website-Check). */
  noindex?: boolean;
}
// Vor dem Start (Domain, Freigabe B4) bleibt die ganze Seite noindex.
const PRELAUNCH = true;
const { title, description, noindex = false } = Astro.props;
const robots = PRELAUNCH || noindex ? "noindex" : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="top-bar">
      <header class="wrap top">
        <a href="/" class="logo">kenntlich<span>.</span></a>
        <nav>
          <a href="/#so-gehts">So funktioniert es</a>
          <a href="/#kontakt">Kontakt</a>
          <a href="/tools/ki-label-generator/" class="btn small">Label-Generator</a>
        </nav>
      </header>
    </div>
    <slot />
    <div class="site-foot">
      <footer class="wrap foot">
        <div>
          <p><strong>kenntlich.</strong> Ein Produkt von dobsonstudio</p>
          <p>Entwickelt in Rottweil, Deutschland. Ohne Cookies, ohne Tracking von Personen.</p>
        </div>
        <nav>
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
      </footer>
    </div>
    <script>
      import { trackContactClicks, trackPageview } from "../scripts/stats.ts";
      trackPageview();
      trackContactClicks();
    </script>
  </body>
</html>
