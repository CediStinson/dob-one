---
import Base from "../layouts/Base.astro";

const problems = [
  {
    title: "Sichtbar gekennzeichnet",
    text: "Ein klares KI-Label direkt im Bild. Wer das Bild sieht, erkennt sofort, dass KI beteiligt war.",
  },
  {
    title: "Maschinenlesbar markiert",
    text: "Beim Export schreibt der Generator auf Wunsch den IPTC-Hinweis \u201eKI-generiert\u201c in die Datei. Plattformen und Prüfwerkzeuge können ihn auslesen.",
  },
  {
    title: "Ohne Upload",
    text: "Alles läuft in Ihrem Browser. Ihre Bilder werden nicht hochgeladen und nicht gespeichert.",
  },
];

const steps = [
  { n: "1", title: "Bilder auswählen", text: "Bis zu 20 Bilder auf einmal, JPG, PNG oder WebP." },
  {
    n: "2",
    title: "Label wählen",
    text: "Vorlage, Position, Größe und Farbe einstellen. Die Vorschau zeigt sofort das Ergebnis.",
  },
  {
    n: "3",
    title: "Herunterladen",
    text: "Einzeln oder alle als ZIP, mit sichtbarem Label und KI-Hinweis in den Metadaten.",
  },
];

const trust = [
  "Entwickelt in Deutschland",
  "Ohne Cookies, ohne Tracking",
  "Ihre Bilder verlassen den Browser nicht",
  "Kostenlos, ohne Login",
];

const stand = "27.11.2026";
const eurLex = "https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32024R1689";
const contact = "mailto:info@dobsonstudio.com?subject=kenntlich";
---

<Base
  title="kenntlich. KI-Bilder richtig kennzeichnen"
  description="KI-Bilder in 10 Sekunden kennzeichnen: sichtbares Label und maschinenlesbarer KI-Hinweis, kostenlos und direkt im Browser."
>
  <main>
    <section class="wrap hero">
      <p class="eyebrow">Art. 50 AI Act</p>
      <h1>KI-Bilder in 10 Sekunden <span>richtig kennzeichnen.</span></h1>
      <p class="lead">
        Sichtbares Label im Bild und maschinenlesbarer KI-Hinweis in der Datei. Kostenlos, ohne Login,
        direkt in Ihrem Browser.
      </p>
      <div class="cta">
        <a href="/tools/ki-label-generator/" class="btn">Jetzt Bilder kennzeichnen</a>
        <a href="#so-gehts" class="btn ghost">So funktioniert es</a>
      </div>
      <ul class="trust" aria-label="Was Sie erwarten können">
        {
          trust.map((t) => (
            <li>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M5 10.5l3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {t}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap block">
      <h2>Was der Label-Generator macht</h2>
      <div class="grid three">
        {
          problems.map((p) => (
            <article class="card">
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="wrap block" id="so-gehts">
      <h2>So funktioniert es</h2>
      <ol class="grid three steps">
        {
          steps.map((s) => (
            <li class="card">
              <span class="num">{s.n}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="after">
        <a href="/tools/ki-label-generator/" class="btn">Zum KI-Label-Generator</a>
      </p>
    </section>

    <section class="wrap block">
      <div class="grid two">
        <article class="card plain">
          <h3>Worauf wir uns beziehen</h3>
          <p class="muted">
            Art.&nbsp;50 der Verordnung (EU) 2024/1689 (KI-Verordnung) regelt Transparenzpflichten für
            KI-Systeme und KI-generierte Inhalte.
          </p>
          <p><a href={eurLex} rel="noopener">Verordnungstext auf EUR-Lex lesen</a></p>
          <p class="faint">Stand der Inhalte: {stand}</p>
        </article>
        <article class="card plain">
          <h3>Wer dahinter steht</h3>
          <p class="muted">
            kenntlich ist ein Produkt von dobsonstudio aus Rottweil. Sie haben einen deutschen
            Ansprechpartner mit Namen und Adresse.
          </p>
          <p><a href="/impressum/">Zum Impressum</a></p>
        </article>
      </div>
    </section>

    <section class="wrap block" id="kontakt">
      <div class="card contact">
        <div>
          <h2>Mehr als einzelne Bilder?</h2>
          <p class="muted">
            Interesse an einer Lösung für WordPress oder an einem Modus für Agenturen? Schreiben Sie
            uns.
          </p>
        </div>
        <a href={contact} class="btn ghost">info@dobsonstudio.com</a>
      </div>
    </section>

    <section class="wrap block">
      <p class="note">
        kenntlich hilft beim Kennzeichnen und wertet Metadaten aus. Die Ergebnisse sind Hinweise, kein
        Beweis, und ersetzen keine Rechtsberatung.
      </p>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 24px;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .hero h1 {
    font-size: clamp(36px, 6vw, 60px);
    margin: 0 0 20px;
    max-width: 860px;
  }
  .hero h1 span {
    color: var(--muted);
  }
  .lead {
    font-size: 20px;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 32px;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .block {
    margin-top: 88px;
  }
  .block h2 {
    font-size: 28px;
    margin: 0 0 24px;
  }
  .grid {
    display: grid;
    gap: 16px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .grid.three {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid.two {
    grid-template-columns: repeat(2, 1fr);
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    color: var(--muted);
    font-size: 15px;
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .trust svg {
    color: var(--accent);
    flex: none;
  }
  .card.plain p + p {
    margin-top: 12px;
  }
  .faint {
    color: var(--faint);
    font-size: 14px;
  }
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
  }
  .card h3 {
    font-size: 18px;
    margin: 0 0 8px;
  }
  .card p {
    margin: 0;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 2px 10px;
    margin-bottom: 12px;
  }
  .badge.live {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .card .tool-link {
    margin-top: 16px;
    font-weight: 600;
  }
  .after {
    margin-top: 20px;
    max-width: 680px;
  }
  .contact {
    background: var(--bg-soft);
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
    align-items: center;
  }
  .contact h2 {
    margin-bottom: 8px;
  }
  .contact .btn {
    justify-self: end;
  }
  @media (max-width: 800px) {
    .grid.three,
    .grid.two,
    .contact {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 40px;
    }
    .contact .btn {
      justify-self: start;
    }
  }
</style>
