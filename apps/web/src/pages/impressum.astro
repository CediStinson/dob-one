---
import Base from "../layouts/Base.astro";
---

<Base title="Impressum. kenntlich" description="Impressum von kenntlich.">
  <main class="wrap prose">
    <h1>Impressum</h1>
    <p class="note">
      Entwurf. Die Angaben werden vor dem Start ergänzt und freigegeben.
    </p>
    <h2>Angaben gemäß § 5 DDG</h2>
    <p class="muted">[Betreiber: dobsonstudio, Name, Anschrift]</p>
    <h2>Kontakt</h2>
    <p class="muted">[E-Mail-Adresse]</p>
    <h2>Verantwortlich für den Inhalt</h2>
    <p class="muted">[Name, Anschrift]</p>
  </main>
</Base>
