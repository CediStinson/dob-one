{
  "name": "dob-one",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @dob-one/web build && wrangler dev",
    "deploy": "wrangler deploy",
    "test:klarbild": "php apps/klarbild/tests/run-local.php"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.20.7",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
