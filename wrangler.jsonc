// Ein Worker: Hono-API unter /api/*, statische Astro-Seiten aus apps/web/dist.
// Cloudflare Workers Builds führt `npx wrangler deploy` aus; wrangler startet vorher build.command.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dob-one",
  "main": "apps/scanner/src/index.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "pnpm install --frozen-lockfile && pnpm build",
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/stats", "/stats/"],
  },
  "observability": { "enabled": true },
  // T19: anonyme Tageszähler. Datenbank von Benjamin angelegt (B6). Die Tabelle legt der Worker selbst an.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dob-one-stats",
      "database_id": "afdd8083-64e1-452c-8ccc-502318326625",
    },
  ],
}
